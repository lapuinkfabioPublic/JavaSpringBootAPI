ature_list_icon_size"";i:2;s:28:""eael_feature_list_icon_space"";i:2;s:30:""eael_feature_list_icon_padding"";i:2;s:44:""eael_feature_list_icon_background_background"";i:1;s:39:""eael_feature_list_icon_background_color"";i:1;}s:39:""eael_section_feature_list_style_content"";a:3:{s:45:""eael_feature_list_title_typography_typography"";i:2;s:46:""eael_feature_list_title_typography_font_family"";i:2;s:46:""eael_feature_list_title_typography_font_weight"";i:2;}}}}s:6:""column"";a:3:{s:5:""count"";i:3;s:15:""control_percent"";i:0;s:8:""controls"";a:1:{s:6:""layout"";a:1:{s:6:""layout"";a:1:{s:12:""_inline_size"";i:3;}}}}s:7:""section"";a:3:{s:5:""count"";i:2;s:15:""control_percent"";i:0;s:8:""controls"";a:1:{s:6:""layout"";a:1:{s:17:""section_structure"";a:1:{s:9:""structure"";i:1;}}}}}",,,,,"a:1:{s:18:""eael_ext_toc_title"";s:19:""Tabla de contenidos"";}","","mastercard",,,,"mastercard.png","Artículos",,"Optional","es",,"Registra tu logo con Mastercard","Te invitamos a registrar el logo de tu negocio y ofrecer mayor seguridad a tus clientes en el momento de pagar con Mastercard.",,,,,,,,,,,,,,,,"registra tu logo con mastercard",,,,,
"¿Semi-integrado o stand alone? ¿Cuál elegir?","24331","<p>Aquí te exponemos un paralelo de las soluciones Semi-integrado y Stand Alone para que puedas identificar cuál es la más conveniente para tu empresa y puedas elegir la opción que mejor se ajuste a tus necesidades y te ayude a seguir agilizando la operación y creciendo tu negocio.</p>		
			<h2>Semi-integrado</h2>		
										<img width=""385"" height=""190"" src=""https://wp-evtc-prd.azurewebsites.net/wp-content/uploads/2021/04/semiIntegrado.png"" alt="""" loading=""lazy"" srcset=""https://wp-evtc-prd.azurewebsites.net/wp-content/uploads/2021/04/semiIntegrado.png 385w, https://wp-evtc-prd.azurewebsites.net/wp-content/uploads/2021/04/semiIntegrado-300x148.png 300w"" sizes=""(max-width: 385px) 100vw, 385px"" />											
			<h5>¿Qué es Semi-integrado? </h5>		
		<p>Es un servicio que permite la integración entre una aplicación que reside en un terminal y una aplicación de caja registradora o de sistema de manejo de negocio. Además de recibir pagos presenciales, permite conectarse con aplicaciones más complejas de manejo de inventario, registro de empleados, entre otras.</p>		
			<h5>Características Semi-integrado</h5>		
			<ul id=""eael-feature-list-6244e53"">
													                <li>
									<img src=""https://dev.creativeteam.co/evertest/wp-content/uploads/2021/04/1-1.png"" alt="""">
							<p							>Es un servicio especializado, que tiene el beneficio de una sola entrada de datos y permite reconciliar las ventas y transacciones facilmente.</p						>
						<p></p>
					</li>
													                <li>
									<img src=""https://dev.creativeteam.co/evertest/wp-content/uploads/2021/04/2-1.png"" alt="""">
							<p							>Requiere de un integrador, como el proveedor de caja registradora del comercio, que haga un desarrollo para generar la integración. Evertec está certificado con los principales proveedores de aplicaciones de restaurantes, retail, supermercados, farmacias, entre otros. </p						>
						<p></p>
					</li>
													                <li>
									<img src=""https://dev.creativeteam.co/evertest/wp-content/uploads/2021/04/3-1.png"" alt="""">
							<p							>Permite agilizar las transacciones, ya que los sistemas y/o módulos están integrados y existe un flujo de data entre ellos. </p						>
						<p></p>
					</li>
													                <li>
									<img src=""https://dev.creativeteam.co/evertest/wp-content/uploads/2021/04/4-1.png"" alt="""">
							<p							>Se puede utilizar en quioscos desatendidos para pagos con tarjeta presente.</p						>
						<p></p>
					</li>
													                <li>
									<img src=""https://dev.creativeteam.co/evertest/wp-content/uploads/2021/04/5-1.png"" alt="""">
							<p							>Si la plataforma del comercio ya está conectada con Evertec, el proceso de integración es mucho más sencillo</p						>
						<p></p>
					</li>
							</ul>
			<h5>
¿Quién debe usar Semi-integrado? 
</h5>		
		<p>Se recomienda para negocios de cualquier tamaño que deseen tener integrado a su sistema de pagos otras funcionalidades que permitan optimizar la operación de su negocio.</p>		
			<h2>Stand alone</h2>		
										<img width=""391"" height=""147"" src=""https://wp-evtc-prd.azurewebsites.net/wp-content/uploads/2021/04/standalone.png"" alt="""" loading=""lazy"" srcset=""https://wp-evtc-prd.azurewebsites.net/wp-content/uploads/2021/04/standalone.png 391w, https://wp-evtc-prd.azurewebsites.net/wp-content/uploads/2021/04/standalone-300x113.png 300w"" sizes=""(max-width: 391px) 100vw, 391px"" />											
			<h5>¿Qué es un terminal Stand Alone?</h5>		
		<p>Es un terminal que no está integrado con ningún sistema de caja registradora; opera por sí solo para manejar cobros en tu negocio.<br />Puede ser un terminal de escritorio o inalámbrico y puede ser utilizado por un comercio de cualquier industria para procesar pagos presenciales, ya sea con tarjetas débito, crédito, QR y ATH Móvil, entre otros.</p>		
			<h5>Características Stand Alone</h5>		
			<ul id=""eael-feature-list-963fa34"">
													                <li>
									<img src=""https://dev.creativeteam.co/evertest/wp-content/uploads/2021/04/1-1.png"" alt="""">
							<p							>Es un servicio sencillo en el que la funcionalidad principal es recibir pagos presenciales. Es de fácil acceso y manejo intuitivo y corre independiente de otros sistemas. No requiere de terceros para generar la integración y el tiempo de implementación es mínimo. </p						>
						<p></p>
					</li>
													                <li>
									<img src=""https://dev.creativeteam.co/evertest/wp-content/uploads/2021/04/2-1.png"" alt="""">
							<p							>No requiere de una integración entre el sistema de POS y el terminal de ventas.</p						>
						<p></p>
					</li>
							</ul>
			<h5>
¿Quién debe usar Stand Alone? 
</h5>		
		<p>Es la manera más fácil de comenzar a recibir pagos en un negocio, pues la instalación es más rápida. Se recomienda para negocios con poco volumen, que requieran una solución de pagos presencial, rápida y sencilla.</p>",,"2021-04-14 22:59:08","semi-integrado-o-stand-alone-cual-elegir","djimenez","publish","https://dev.creativeteam.co/evertest/wp-content/uploads/2021/04/integrado.png","standard","open","open",,"wp-post","3.1.1","3.0.10","default","builder",,"a:8:{s:11:""text-editor"";a:3:{s:5:""count"";i:6;s:15:""control_percent"";i:0;s:8:""controls"";a:1:{s:7:""content"";a:1:{s:14:""section_editor"";a:1:{s:6:""editor"";i:6;}}}}s:7:""divider"";a:3:{s:5:""count"";i:1;s:15:""control_percent"";i:0;s:8:""controls"";a:1:{s:5:""style"";a:1:{s:21:""section_divider_style"";a:2:{s:6:""weight"";i:1;s:3:""gap"";i:1;}}}}s:7:""heading"";a:3:{s:5:""count"";i:8;s:15:""control_percent"";i:1;s:8:""controls"";a:2:{s:7:""content"";a:1:{s:13:""section_title"";a:3:{s:5:""title"";i:8;s:5:""align"";i:8;s:11:""header_size"";i:6;}}s:8:""advanced"";a:3:{s:15:""section_effects"";a:1:{s:10:""_animation"";i:8;}s:19:""_section_background"";a:1:{s:22:""_background_background"";i:8;}s:14:""_section_style"";a:1:{s:8:""_padding"";i:8;}}}}s:6:""spacer"";a:3:{s:5:""count"";i:4;s:15:""control_percent"";i:0;s:8:""controls"";a:1:{s:7:""content"";a:1:{s:14:""section_spacer"";a:1:{s:5:""space"";i:4;}}}}s:5:""image"";a:3:{s:5:""count"";i:2;s:15:""control_percent"";i:1;s:8:""controls"";a:2:{s:7:""content"";a:1:{s:13:""section_image"";a:1:{s:5:""image"";i:2;}}s:8:""advanced"";a:1:{s:15:""section_effects"";a:3:{s:27:""motion_fx_mouseTrack_effect"";i:2;s:10:""_animation"";i:2;s:18:""animation_duration"";i:2;}}}}s:17:""eael-feature-list"";a:3:{s:5:""count"";i:2;s:15:""control_percent"";i:2;s:8:""controls"";a:2:{s:7:""content"";a:1:{s:42:""eael_section_feature_list_content_settings"";a:2:{s:17:""eael_feature_list"";i:2;s:28:""eael_feature_list_title_size"";i:2;}}s:5:""style"";a:3:{s:31:""eael_section_feature_l