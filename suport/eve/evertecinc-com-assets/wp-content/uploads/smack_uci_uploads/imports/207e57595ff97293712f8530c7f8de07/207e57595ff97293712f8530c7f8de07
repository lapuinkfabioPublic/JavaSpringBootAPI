											&lt;/td&gt;
																										&lt;/tr&gt;
			        						&lt;tr&gt;
																   											&lt;td colspan="" rowspan="" id=""&gt;
												2016
											&lt;/td&gt;
																													   											&lt;td colspan="" rowspan="" id=""&gt;
												Detectar fraudes de manera efectiva.
											&lt;/td&gt;
																													   											&lt;td colspan="" rowspan="" id=""&gt;
												Soluci&#xF3;n para la detecci&#xF3;n de fraudes omnicanal Risk Center Emisor.
											&lt;/td&gt;
																										&lt;/tr&gt;
			        						&lt;tr&gt;
																   											&lt;td colspan="" rowspan="" id=""&gt;
												2019
											&lt;/td&gt;
																													   											&lt;td colspan="" rowspan="" id=""&gt;
												Proveer una soluci&#xF3;n integral de adquirencia.
											&lt;/td&gt;
																													   											&lt;td colspan="" rowspan="" id=""&gt;
												Soluci&#xF3;n integral de adquirencia para Chile con la plataforma Paystudio, incluyendo eCommerce (Placetopay), fraude, cargos recurrentes, y otros.
											&lt;/td&gt;
																										&lt;/tr&gt;
			        						&lt;tr&gt;
																   											&lt;td colspan="" rowspan="" id=""&gt;
												2021
											&lt;/td&gt;
																													   											&lt;td colspan="" rowspan="" id=""&gt;
												Expandir soluciones de adquirencia a m&#xE1;s pa&#xED;ses.
											&lt;/td&gt;
																													   											&lt;td colspan="" rowspan="" id=""&gt;
												Lanzamiento de GetNet - Soluci&#xF3;n integral de adquirencia para Uruguay, incluyendo eCommerce, fraude, cargos recurrentes, y otros. 
											&lt;/td&gt;
