		&lt;p&gt;&#xA0;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;5.&lt;/strong&gt; Luego oprime PASO 2 para completar tu SAQ.&lt;/p&gt;		
									&lt;figure&gt;
											&lt;a href="https://stwpevtcstorage01.blob.core.windows.net/imagenes-portal/2020/09/7-paso2.jpg" data-elementor-open-lightbox="yes" e-action-hash="#elementor-action%3Aaction%3Dlightbox%26settings%3DeyJpZCI6NTU4OSwidXJsIjoiaHR0cHM6XC9cL3dwLWV2dGMuYXp1cmV3ZWJzaXRlcy5uZXRcL3dwLWNvbnRlbnRcL3VwbG9hZHNcLzIwMjBcLzA5XC83LXBhc28yLmpwZyJ9"&gt;
